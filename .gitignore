# Android build output (any depth — the plugin's own android/ AND every
# example app's src-tauri/gen/android/ produce these)
**/android/build
**/android/.gradle
**/android/.tauri
**/android/local.properties
**/gen/android/**/build
**/gen/android/**/.gradle
**/gen/android/local.properties
**/gen/android/.idea

# iOS build output (any depth — the plugin's own ios/ AND every example
# app's src-tauri/gen/apple/ produce these)
**/ios/.build
**/ios/.tauri
**/ios/Packages
**/ios/*.xcodeproj
**/ios/Package.resolved
**/gen/apple/**/build
**/gen/apple/**/DerivedData

